# ----- General -----
# macOS system files
.DS_Store

# ----- Python -----
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
-dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Pytest cache
.pytest_cache/

# mypy
.mypy_cache/

# ----- Node / Frontend -----
node_modules/
npm-debug.log
yarn-error.log

# Next.js build output
.next/
out/

# Environment files
.env
.env.*

# Sensitive data / secrets
*.key
*.pem
*.crt

# SQLite database (keep local, but not commit)
backend/data/*.db
backend/data/*.sqlite3

# Logs
*.log


# Local portable runtimes
bin/

# Local application data
data/*.db
data/*.sqlite3
data/*.sqlite

# Local caches and generated files
.cache/
.tmp/
docs/*.pdf
